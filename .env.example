# Copy to .env and fill in. .env is not committed.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=healthtrack
DB_USER=postgres
DB_PASSWORD=

# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Host processes (pytest, a local uvicorn) use localhost.
# docker-compose overrides this for the API container.
REDIS_URL=redis://localhost:6379/0

# Seeded on API startup. analyst can read; admin can also clear the cache.
ANALYST_PASSWORD=
ADMIN_PASSWORD=
